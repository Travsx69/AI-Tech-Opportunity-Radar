# Optional GitHub authentication; recommended for scheduled runs.
GITHUB_TOKEN=

# Local AI configuration.
AI_PROVIDER=ollama
OLLAMA_MODEL=qwen3.5:9b
OLLAMA_URL=http://localhost:11434

# OpenRouter configuration (used only when AI_PROVIDER=openrouter).
OPENROUTER_API_KEY=
OPENROUTER_MODEL=openrouter/free
OPENROUTER_TIMEOUT=120

# Radar runtime configuration.
RADAR_DATA_DIR=data
RADAR_MAX_ANALYZED=5
RADAR_PER_QUERY=5
# Optional: alternative free-source config (default config/sources.json).
RADAR_SOURCES_CONFIG=

# Required only to import the workflow through the n8n public API.
N8N_API_KEY=
N8N_BASE_URL=http://localhost:5678
